# Funnel analytics for the FREE WEB build only (see src/analytics.js).
# Leave unset (dev, local builds) and nothing is sent. Set these in the
# Netlify site's Environment variables to turn tracking on for the deploy.

# Your Plausible site domain, e.g. herokana.netlify.app
VITE_PLAUSIBLE_DOMAIN=

# Optional: override the script URL to self-host (Plausible/Umami).
# Defaults to Plausible Cloud's tagged-events script.
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js
